{
  "name": "the-hogans",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/the-hogans",
  "projectType": "application",
  "tags": [],
  "targets": {
    "sitemap": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pages/**/*",
        "{projectRoot}/scripts/generate-sitemap.mjs"
      ],
      "outputs": ["{projectRoot}/public/sitemap.xml"],
      "options": {
        "command": "node apps/the-hogans/scripts/generate-sitemap.mjs"
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "dependsOn": ["sitemap"],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/the-hogans",
        "outputPath": "dist/apps/the-hogans"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/the-hogans"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "the-hogans:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "the-hogans:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "the-hogans:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "the-hogans:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/the-hogans/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/the-hogans/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
