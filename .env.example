# Might not be needed (Firebase Server Functions)
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Turso (play2winff) — server-only, read in pages/api/*. Must also be set in
# Vercel (Production + Preview) for the play2winff deployment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Turso (Dom's RadTech tracker, the-hogans /dom/radtech) — server-only, read
# in apps/the-hogans/pages/api/dom/*. Also set on the nx-the-hogans Vercel
# project.
RADTECH_TRACKER_TURSO_DATABASE_URL=
RADTECH_TRACKER_TURSO_AUTH_TOKEN=

# Shared family-auth identity provider (libs/auth) — same Supabase project
# used by recipes/dm-toolkit/play2winff/shopping-list, just for magic-link
# sign-in. Client-exposed (NEXT_PUBLIC_*) by design; not a secret.
NEXT_PUBLIC_AUTH_SUPABASE_URL=
NEXT_PUBLIC_AUTH_SUPABASE_ANON_KEY=
# Per-app allowlist read by libs/auth on the server only (no NEXT_PUBLIC_, so
# the emails never reach the browser; the client asks /api/auth/me). Set
# independently for each app's own Vercel project, not shared across apps even
# though the identity provider is. Comma-separated.
AUTH_FAMILY_EMAILS=
AUTH_LIMITED_EMAILS=
